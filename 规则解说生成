# -*- coding: utf-8 -*-
"""Rule-based match commentary generation from detection results.

The image modality produces structured detections; this module turns them
into human-readable Chinese commentary (for display and TTS broadcasting).
Two analysis modes are provided:

- Static tactics briefing: derived from a single frame's detections.
- Temporal event stream: derived from per-frame ball positions of a video
  clip, using nearest-neighbour tracking and geometric event rules.
"""
from dataclasses import dataclass, field

BALL = 0
PLAYER = 1

# vertical thirds of the frame (attacking direction is not labelled in the
# dataset, so we describe zones relative to the camera view)
ZONES = ["守方后场", "中场区域", "攻方前场"]  # top / middle / bottom of frame


@dataclass
class MatchEvent:
    """A single commentary event with its timestamp (seconds)."""

    time: float
    kind: str
    text: str


@dataclass
class FrameState:
    """Detections of one frame, normalised coordinates (0-1, top-left origin)."""

    timestamp: float
    boxes: list  # list of (class_id, cx, cy, w, h, conf)
    ball_track_id: int | None = None


@dataclass
class BallTrack:
    """Simple nearest-neighbour tracker state for the ball."""

    track_id: int = 0
    last_cx: float | None = None
    last_cy: float | None = None
    history: list = field(default_factory=list)  # [(t, cx, cy), ...]


def _best_ball(boxes):
    candidates = [b for b in boxes if b[0] == BALL]
    if not candidates:
        return None
    return max(candidates, key=lambda b: b[5])


def _zone_name(cy: float) -> str:
    return ZONES[min(int(cy * 3), 2)]


def describe_frame(state: FrameState) -> list[str]:
    """Static briefing sentences for one frame's detections."""
    players = [b for b in state.boxes if b[0] == PLAYER]
    ball = _best_ball(state.boxes)
    sentences = []

    n_players = len(players)
    if n_players == 0:
        sentences.append("画面中未检测到球员。")
        return sentences

    # spatial distribution over a 3x3 grid
    cols = [0, 0, 0]
    rows = [0, 0, 0]
    for _, cx, cy, _, _, _ in players:
        cols[min(int(cx * 3), 2)] += 1
        rows[min(int(cy * 3), 2)] += 1
    col_names = ["左路", "中路", "右路"]
    sentences.append(
        f"画面中共检测到 {n_players} 名球员，"
        f"左路 {cols[0]} 人、中路 {cols[1]} 人、右路 {cols[2]} 人。"
    )

    dense_col = cols.index(max(cols))
    dense_row = rows.index(max(rows))
    sentences.append(f"球员主要聚集在{col_names[dense_col]}的{ZONES[dense_row]}。")

    if ball is not None:
        _, bx, by, _, _, bconf = ball
        near = sum(1 for _, cx, cy, _, _, _ in players
                   if ((cx - bx) ** 2 + (cy - by) ** 2) ** 0.5 < 0.18)
        if near >= 4:
            heat = "争夺十分激烈"
        elif near >= 2:
            heat = "有多人贴身拼抢"
        else:
            heat = "球附近人员稀少"
        sentences.append(
            f"足球位于{_zone_name(by)}（置信度 {bconf:.2f}），"
            f"周边 0.18 归一化半径内有 {near} 名球员，{heat}。"
        )
    else:
        sentences.append("本帧未能检测到足球，可能被球员遮挡或画面过远。")
    return sentences


def _speed(track: BallTrack) -> float:
    """Normalised units per second over the last two tracked positions."""
    if len(track.history) < 2:
        return 0.0
    (t0, x0, y0), (t1, x1, y1) = track.history[-2], track.history[-1]
    dt = max(t1 - t0, 1e-3)
    return ((x1 - x0) ** 2 + (y1 - y0) ** 2) ** 0.5 / dt


def update_track(track: BallTrack, state: FrameState) -> BallTrack:
    """Nearest-neighbour association of the highest-confidence ball."""
    ball = _best_ball(state.boxes)
    if ball is None:
        return track
    _, cx, cy, _, _, _ = ball
    if track.last_cx is not None:
        dist = ((cx - track.last_cx) ** 2 + (cy - track.last_cy) ** 2) ** 0.5
        if dist > 0.35:  # too far to be the same ball: reset track
            track.track_id += 1
            track.history = []
    track.last_cx, track.last_cy = cx, cy
    track.history.append((state.timestamp, cx, cy))
    track.history = track.history[-8:]
    state.ball_track_id = track.track_id
    return track


def build_event_stream(states: list[FrameState]) -> list[MatchEvent]:
    """Turn per-frame detections into a chronological event commentary.

    Rules (geometric, no learned component needed):
    - FAST_MOVE: ball speed above 0.55 units/s -> long pass / shot on goal
    - ZONE_ENTER: ball crosses into a new vertical zone -> attack build-up
    - REGROUP: ball track reset (ball lost then reacquired) -> turnover
    - CROWD: 5+ players within 0.18 of the ball -> set-piece scramble
    """
    track = BallTrack()
    events: list[MatchEvent] = []
    last_zone = None
    last_event_t = -1.0

    def emit(t: float, kind: str, text: str, min_gap: float = 1.0):
        nonlocal last_event_t
        if t - last_event_t < min_gap:
            return
        events.append(MatchEvent(round(t, 2), kind, text))
        last_event_t = t

    for state in states:
        players = [b for b in state.boxes if b[0] == PLAYER]
        ball = _best_ball(state.boxes)
        prev_id = track.track_id
        update_track(track, state)

        if ball is None:
            continue
        _, bx, by, _, _, _ = ball

        if track.track_id != prev_id:
            emit(state.timestamp, "REGROUP", "球权发生转换，双方重新组织。")

        speed = _speed(track)
        if speed > 0.55:
            if by > 0.66:
                emit(state.timestamp, "FAST_MOVE", "足球快速飞向禁区方向，射门机会出现！")
            else:
                emit(state.timestamp, "FAST_MOVE", "一记大范围转移，球快速穿过中场。")

        zone = min(int(by * 3), 2)
        if last_zone is not None and zone != last_zone:
            if zone > last_zone:
                emit(state.timestamp, "ZONE_ENTER",
                     f"进攻推进，球进入{_zone_name(by)}。")
            else:
                emit(state.timestamp, "ZONE_ENTER",
                     f"回防成功，球回到{_zone_name(by)}。")
        last_zone = zone

        near = sum(1 for _, cx, cy, _, _, _ in players
                   if ((cx - bx) ** 2 + (cy - by) ** 2) ** 0.5 < 0.18)
        if near >= 5:
            emit(state.timestamp, "CROWD", "禁区内多人混战，球在小范围内快速易手。", 2.0)

    if not events:
        events.append(MatchEvent(0.0, "NONE", "本片段未检测到显著比赛事件。"))
    return events


def events_to_script(events: list[MatchEvent]) -> str:
    """Concatenate events into one broadcast script paragraph."""
    parts = []
    for e in events:
        minutes = int(e.time // 60)
        seconds = int(e.time % 60)
        parts.append(f"[{minutes:02d}:{seconds:02d}] {e.text}")
    return "\n".join(parts)
