# -*- coding: utf-8 -*-
"""Image modality: YOLO-based football detection pipeline for the web app."""
from dataclasses import dataclass, field
from pathlib import Path

import cv2
import numpy as np

BALL, PLAYER = 0, 1

CLASS_NAMES = {BALL: "ball", PLAYER: "player"}

# post-processing layer of the small-object enhancement: balls are tiny and
# often scored low, so they keep a lower confidence threshold than players
BALL_CONF_DEFAULT = 0.2


@dataclass
class Detection:
    class_id: int
    class_name: str
    conf: float
    cx: float  # normalised centre-x
    cy: float
    w: float
    h: float

    def to_pixel(self, width: int, height: int) -> tuple[int, int, int, int]:
        x1 = int((self.cx - self.w / 2) * width)
        y1 = int((self.cy - self.h / 2) * height)
        x2 = int((self.cx + self.w / 2) * width)
        y2 = int((self.cy + self.h / 2) * height)
        return x1, y1, x2, y2


@dataclass
class ImageResult:
    boxes: list[Detection] = field(default_factory=list)
    width: int = 0
    height: int = 0

    def stats(self) -> dict:
        balls = [b for b in self.boxes if b.class_id == BALL]
        players = [b for b in self.boxes if b.class_id == PLAYER]
        return {
            "players": len(players),
            "balls": len(balls),
            "detections": len(self.boxes),
            "avg_player_conf": round(float(np.mean([b.conf for b in players])), 3)
            if players else 0.0,
        }


@dataclass
class VideoResult:
    frame_results: list[ImageResult] = field(default_factory=list)
    fps: float = 0.0
    duration: float = 0.0

    def stats(self) -> dict:
        players_per_frame = [len([b for b in fr.boxes if b.class_id == PLAYER])
                             for fr in self.frame_results] or [0]
        balls_per_frame = [len([b for b in fr.boxes if b.class_id == BALL])
                           for fr in self.frame_results] or [0]
        return {
            "frames_analyzed": len(self.frame_results),
            "avg_players": round(float(np.mean(players_per_frame)), 1),
            "max_players": int(np.max(players_per_frame)),
            "ball_visible_ratio": round(
                sum(1 for n in balls_per_frame if n > 0) / max(len(balls_per_frame), 1), 3),
        }


class FootballDetector:
    """Thin wrapper around an ultralytics YOLO model with normalised outputs."""

    def __init__(self, weights: str, conf: float = 0.25, iou: float = 0.45,
                 ball_conf: float = BALL_CONF_DEFAULT):
        # importing bifpn makes pickled custom modules of the improved model resolvable
        from src.models import bifpn  # noqa: F401
        from ultralytics import YOLO

        self.model = YOLO(weights)
        self.conf = conf          # player threshold (also the slider value)
        self.iou = iou
        self.ball_conf = ball_conf

    @property
    def min_conf(self) -> float:
        """Lowest per-class threshold; the model must keep these candidates."""
        return min(self.conf, self.ball_conf)

    def _run_model(self, image_bgr: np.ndarray):
        """Predict once, then apply the per-class confidence thresholds."""
        output = self.model.predict(image_bgr, conf=self.min_conf,
                                    iou=self.iou, verbose=False)[0]
        if len(output.boxes):
            confs = output.boxes.conf
            clss = output.boxes.cls
            keep = ((clss == BALL) & (confs >= self.ball_conf)) | \
                   ((clss != BALL) & (confs >= self.conf))
            output.boxes = output.boxes[keep]
        return output

    def detect_image(self, image_bgr: np.ndarray) -> ImageResult:
        output = self._run_model(image_bgr)
        return self._to_result(output, image_bgr.shape[1], image_bgr.shape[0])

    def _to_result(self, output, w: int, h: int) -> ImageResult:
        result = ImageResult(width=w, height=h)
        for b in output.boxes:
            cls = int(b.cls.item())
            x1, y1, x2, y2 = b.xyxyn[0].tolist()
            result.boxes.append(Detection(
                class_id=cls,
                class_name=CLASS_NAMES.get(cls, str(cls)),
                conf=float(b.conf.item()),
                cx=(x1 + x2) / 2, cy=(y1 + y2) / 2, w=x2 - x1, h=y2 - y1,
            ))
        return result

    def annotate_image(self, image_bgr: np.ndarray) -> np.ndarray:
        return self._run_model(image_bgr).plot()

    def detect_video(self, video_path: str, out_path: str | None = None,
                     frame_stride: int = 1, max_frames: int = 600) -> VideoResult:
        """Analyze a video frame by frame; optionally write an annotated mp4."""
        capture = cv2.VideoCapture(video_path)
        if not capture.isOpened():
            raise IOError(f"cannot open video: {video_path}")
        fps = capture.get(cv2.CAP_PROP_FPS) or 25.0
        total = int(capture.get(cv2.CAP_PROP_FRAME_COUNT))
        writer = None
        if out_path:
            fourcc = cv2.VideoWriter_fourcc(*"mp4v")
            w = int(capture.get(cv2.CAP_PROP_FRAME_WIDTH))
            h = int(capture.get(cv2.CAP_PROP_FRAME_HEIGHT))
            writer = cv2.VideoWriter(out_path, fourcc, fps / frame_stride, (w, h))

        video_result = VideoResult(fps=fps, duration=total / fps if fps else 0.0)
        index = 0
        analyzed = 0
        while analyzed < max_frames:
            ok, frame = capture.read()
            if not ok:
                break
            if index % frame_stride == 0:
                output = self._run_model(frame)
                video_result.frame_results.append(
                    self._to_result(output, frame.shape[1], frame.shape[0]))
                if writer is not None:
                    writer.write(output.plot())
                analyzed += 1
            index += 1
        capture.release()
        if writer is not None:
            writer.release()
        return video_result
